<Window x:Class="RoboMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RoboMonitor"
        Height="820"
        Width="1360"
        MinHeight="720"
        MinWidth="1180"
        WindowStartupLocation="CenterScreen"
        Background="#0B1120">
    <Window.Resources>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#111827" />
            <Setter Property="BorderBrush" Value="#1F2937" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="ControlButton" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="#1F2937" />
            <Setter Property="Foreground" Value="#F9FAFB" />
            <Setter Property="BorderBrush" Value="#374151" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="EmergencyButton" TargetType="Button" BasedOn="{StaticResource ControlButton}">
            <Setter Property="Background" Value="#991B1B" />
            <Setter Property="BorderBrush" Value="#DC2626" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F9FAFB" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#111827" />
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="BorderBrush" Value="#1F2937" />
            <Setter Property="RowBackground" Value="#111827" />
            <Setter Property="AlternatingRowBackground" Value="#0F172A" />
            <Setter Property="HorizontalGridLinesBrush" Value="#1F2937" />
            <Setter Property="VerticalGridLinesBrush" Value="#1F2937" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding ApplicationTitle}" Foreground="White" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="{Binding Subtitle}" Foreground="#6B7280" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Padding="12,7" CornerRadius="6" Margin="0,0,8,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#3F1D1D" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Background" Value="#123524" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ConnectionText}" Foreground="#F9FAFB" FontWeight="SemiBold" FontSize="12" />
                    </Border>
                    <Border Background="#172554" Padding="12,7" CornerRadius="6">
                        <TextBlock Text="{Binding ModeText}" Foreground="#BFDBFE" FontWeight="SemiBold" FontSize="12" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1F2937" BorderThickness="0,0,1,0">
                <StackPanel Margin="18,22">
                    <TextBlock Text="ROBOT CONTROL" Foreground="#6B7280" FontSize="11" FontWeight="Bold" Margin="0,0,0,14" />
                    <Button Content="{Binding ConnectionText}" Command="{Binding ConnectCommand}" Style="{StaticResource ControlButton}" />
                    <Button Content="{Binding ServoText}" Command="{Binding ServoCommand}" Style="{StaticResource ControlButton}" />
                    <Button Content="START" Command="{Binding StartCommand}" Style="{StaticResource ControlButton}" />
                    <Button Content="STOP" Command="{Binding StopCommand}" Style="{StaticResource ControlButton}" />
                    <Button Content="CHANGE MODE" Command="{Binding ToggleModeCommand}" Style="{StaticResource ControlButton}" />

                    <Separator Margin="0,16" Background="#1F2937" />

                    <TextBlock Text="SAFETY" Foreground="#6B7280" FontSize="11" FontWeight="Bold" Margin="0,0,0,14" />
                    <Button Content="EMERGENCY STOP" Command="{Binding EmergencyStopCommand}" Style="{StaticResource EmergencyButton}" />
                    <Button Content="RESET E-STOP" Command="{Binding ResetEmergencyCommand}" Style="{StaticResource ControlButton}" />

                    <Border Margin="0,24,0,0" Padding="12" CornerRadius="8" Background="#111827">
                        <StackPanel>
                            <TextBlock Text="Safety State" Foreground="#6B7280" FontSize="11" />
                            <TextBlock Text="{Binding EmergencyText}" Foreground="#F9FAFB" FontWeight="Bold" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="22">
                    <UniformGrid Columns="4" Margin="0,0,0,16">
                        <Border Style="{StaticResource PanelStyle}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="ROBOT STATE" Foreground="#6B7280" FontSize="11" FontWeight="Bold" />
                                <TextBlock Text="{Binding RunStateText}" Foreground="#F9FAFB" FontSize="22" FontWeight="Bold" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelStyle}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="SPEED" Foreground="#6B7280" FontSize="11" FontWeight="Bold" />
                                <TextBlock Text="{Binding Speed, StringFormat={}{0:F1} %}" Foreground="#F9FAFB" FontSize="22" FontWeight="Bold" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelStyle}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="TEMPERATURE" Foreground="#6B7280" FontSize="11" FontWeight="Bold" />
                                <TextBlock Text="{Binding Temperature, StringFormat={}{0:F1} °C}" Foreground="#F9FAFB" FontSize="22" FontWeight="Bold" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelStyle}">
                            <StackPanel>
                                <TextBlock Text="OPERATION TIME" Foreground="#6B7280" FontSize="11" FontWeight="Bold" />
                                <TextBlock Text="{Binding OperationTimeText}" Foreground="#F9FAFB" FontSize="22" FontWeight="Bold" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Joint Position" Style="{StaticResource SectionTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Grid.Column="0" Background="#0F172A" CornerRadius="7" Padding="14" Margin="0,0,8,8">
                                        <StackPanel>
                                            <TextBlock Text="J1" Foreground="#6B7280" FontWeight="Bold" />
                                            <TextBlock Text="{Binding Joint1, StringFormat={}{0:F1}°}" Foreground="White" FontSize="20" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="1" Background="#0F172A" CornerRadius="7" Padding="14" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="J2" Foreground="#6B7280" FontWeight="Bold" />
                                            <TextBlock Text="{Binding Joint2, StringFormat={}{0:F1}°}" Foreground="White" FontSize="20" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="0" Background="#0F172A" CornerRadius="7" Padding="14" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="J3" Foreground="#6B7280" FontWeight="Bold" />
                                            <TextBlock Text="{Binding Joint3, StringFormat={}{0:F1}°}" Foreground="White" FontSize="20" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="1" Background="#0F172A" CornerRadius="7" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="J4" Foreground="#6B7280" FontWeight="Bold" />
                                            <TextBlock Text="{Binding Joint4, StringFormat={}{0:F1}°}" Foreground="White" FontSize="20" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource PanelStyle}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Control Status" Style="{StaticResource SectionTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="40" />
                                        <RowDefinition Height="40" />
                                        <RowDefinition Height="40" />
                                        <RowDefinition Height="40" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="Connection" Foreground="#6B7280" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ConnectionText}" Foreground="#E5E7EB" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="1" Text="Servo" Foreground="#6B7280" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ServoText}" Foreground="#E5E7EB" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="2" Text="Mode" Foreground="#6B7280" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ModeText}" Foreground="#E5E7EB" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="3" Text="Safety" Foreground="#6B7280" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding EmergencyText}" Foreground="#E5E7EB" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Alarm History" Style="{StaticResource SectionTitle}" />
                                <DataGrid ItemsSource="{Binding Alarms}" Height="210" AutoGenerateColumns="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="80" />
                                        <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="90" />
                                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource PanelStyle}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Operation Log" Style="{StaticResource SectionTitle}" />
                                <DataGrid ItemsSource="{Binding Logs}" Height="210" AutoGenerateColumns="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="80" />
                                        <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="90" />
                                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
